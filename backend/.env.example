# انسخ هذا الملف إلى .env وعبّي القيم الحقيقية — لا ترفع .env على GitHub أبداً
DATABASE_URL="postgresql://jadara_user:jadara_pass@localhost:5432/jadara_finance"
JWT_SECRET="غيّر-هذا-إلى-نص-عشوائي-طويل-وسري-16حرفاً-على-الأقل"
JWT_EXPIRES_IN="7d"
PORT=4000
APP_URL="http://localhost:5173"

# ===== حساب المالك (سرّي) =====
# لا يوجد تسجيل ولا إنشاء حساب للمالك في الواجهة.
# 1) ضع بريدك وكلمة مرورك هنا
# 2) شغّل: npm run prisma:seed
# 3) ادخل من: http://localhost:5173/owner-portal
# استعادة كلمة المرور تحتاج SMTP بالأسفل.
# لتغيير كلمة المرور دون بريد: ادخل بوابة المالك → «كلمة المرور».
# npm run prisma:seed يحدّث البريد من OWNER_EMAIL؛ لا يعيد كتابة كلمة المرور إذا كان الحساب موجوداً.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me-before-seed"
OWNER_PATH="/owner-portal"

# بدون SMTP يستخدم السيرفر sendmail إن وُجد. بدون الاثنين لن يصل الإيميل لصندوق الوارد.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="owner@example.com"
# SMTP_PASS=""
# MAIL_FROM="جداره Finance <noreply@jadara-finance.com>"
# SUPPORT_EMAIL="info@jadara-finance.com"
# NOTIFY_EMAIL="info@jadara-finance.com"
# مسار OpenSSL لتوليد CSR الخاص بفاتورة (اختياري إذا كان openssl في PATH)
# OPENSSL_PATH="C:\\Program Files\\Git\\mingw64\\bin\\openssl.exe"
# Official ZATCA .NET SDK (extracted zip). Required to sign invoices with fatooraNet.
# ZATCA_SDK_HOME="C:\\path\\to\\zatca-einvoicing-sdk-DotNet-238-R3.4.8"
